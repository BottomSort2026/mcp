# Flame in Freefall MCP service. Copy to .env for `pnpm dev`; in Docker, set these on the container.

# Port for POST /chat, POST /mcp and GET /health. The gateway expects MCP_URL=http://mcp:8001.
PORT=8001

# corpus.db built by the train repo, opened read-only. The image defaults to /app/storage/corpus.db.
CORPUS_PATH=storage/corpus.db

# Engine service: POST /embed for query vectors (and /predict when enabled). The embedding model
# and dimension come from corpus_info, not from here. If the engine is down, search uses BM25 alone.
ENGINE_URL=http://localhost:8000

# LLM used for routing and for the answer: openai (default, any OpenAI-compatible chat
# completions endpoint) or anthropic (Claude through the native Messages API).
# LLM_PROVIDER=openai

# With LLM_PROVIDER=openai:
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=llama3.1
# LLM_API_KEY=

# With LLM_PROVIDER=anthropic, LLM_URL is ignored and the key is required. LLM_MODEL defaults
# to claude-sonnet-5-5. Never commit the key or bake it into the image.
# ANTHROPIC_API_KEY=
# Output cap per call (thinking included); the Messages API requires it.
# LLM_MAX_TOKENS=4096

# Timeout for each LLM call, in ms (both providers). Engine calls use 20 s.
# LLM_TIMEOUT_MS=60000

# Simulation through ${ENGINE_URL}/predict. Keep it off: the engine's /predict is still a
# placeholder, so the simulate intent falls back to retrieval.
# PREDICT_ENABLED=false

# Offline reports (pnpm report investigations) read only ANTHROPIC_API_KEY, CORPUS_PATH,
# ENGINE_URL (optional) and this. They never run in the image.
# REPORT_MODEL=claude-opus-5-5
