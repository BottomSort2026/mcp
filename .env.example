# Index file built by the training service. The server opens it read-only.
DB_PATH=data/app.sqlite
PORT=3000

# Embedding engine that owns the retrieval model (query embeddings only).
EMBED_URL=http://localhost:11434/v1/embeddings
EMBED_MODEL=nomic-embed-text

# Must match the dimension the training service stored, or boot fails.
EMBED_DIM=768

# Chat provider used for translation/routing and final answers.
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=llama3.1  
# LLM_API_KEY=

# Optional simulation endpoint. Without it, the simulate intent falls back to retrieval.
# PREDICT_URL=http://localhost:8000/predict
